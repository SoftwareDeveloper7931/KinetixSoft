---
export interface Props {
  faqs: Array<{ question: string; answer: string }>;
}

const { faqs } = Astro.props;
---

{faqs && faqs.length > 0 && (
  <section class="my-14 pt-8 border-t border-slate-200 dark:border-slate-800">
    <div class="flex items-center gap-2 mb-6">
      <span class="text-xs uppercase font-bold tracking-wider text-brand-600 dark:text-brand-400">Frequently Asked Questions</span>
    </div>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Common Questions &amp; Expert Answers</h2>
    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-5 open:bg-slate-50 dark:open:bg-slate-900 transition-colors">
          <summary class="flex items-center justify-between cursor-pointer list-none text-base font-semibold text-slate-900 dark:text-slate-100 group-hover:text-brand-600 dark:group-hover:text-brand-400">
            <span>{faq.question}</span>
            <svg class="w-5 h-5 text-slate-400 transition-transform duration-200 group-open:rotate-180 shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </summary>
          <div class="mt-3 text-sm text-slate-600 dark:text-slate-300 leading-relaxed pt-2 border-t border-slate-100 dark:border-slate-800">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
)}
