---
export interface Props {
  headline?: string;
  subtext?: string;
  compact?: boolean;
}

const {
  headline = "Need a FlutterFlow app built?",
  subtext = "KinetixSoft's senior engineering team designs, builds, and deploys high-performance mobile and web apps with production-grade architecture.",
  compact = false
} = Astro.props;
---

{compact ? (
  <div class="my-8 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 p-5 text-white shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4">
    <div>
      <p class="font-bold text-base m-0 text-white">{headline}</p>
      <p class="text-xs text-brand-100 m-0 mt-1">{subtext}</p>
    </div>
    <a href="/contact/" class="shrink-0 px-4 py-2 bg-white text-brand-700 hover:bg-brand-50 rounded-lg text-xs font-bold transition-transform hover:scale-105 active:scale-95 shadow-sm">
      Talk to KinetixSoft →
    </a>
  </div>
) : (
  <div class="my-12 rounded-2xl bg-gradient-to-br from-slate-900 via-brand-950 to-slate-900 border border-brand-800/50 p-8 sm:p-10 text-white shadow-xl relative overflow-hidden">
    <!-- Subtle glow backgrounds -->
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-500/20 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -bottom-20 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-500/20 text-brand-300 text-xs font-semibold mb-4 border border-brand-500/30">
        <span>🚀 Production-Grade FlutterFlow Engineering</span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight mb-3">
        {headline}
      </h3>
      <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
        {subtext} We handle complex backend integrations, Supabase schemas, Stripe monetization, and custom Dart actions so you can scale without bottlenecks.
      </p>
      <div class="flex flex-wrap items-center gap-4">
        <a href="/contact/" class="px-6 py-3 bg-brand-500 hover:bg-brand-400 text-white rounded-xl text-sm font-bold shadow-lg shadow-brand-500/30 transition-all hover:scale-[1.02] active:scale-95 flex items-center gap-2">
          <span>Talk to KinetixSoft</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <a href="/about/" class="px-5 py-3 rounded-xl text-sm font-semibold text-slate-300 hover:text-white hover:bg-white/10 transition-colors">
          Learn How We Work
        </a>
      </div>
    </div>
  </div>
)}
