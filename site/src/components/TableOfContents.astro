---
export interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
}

const { headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{tocHeadings.length > 0 && (
  <nav aria-label="Table of contents" class="space-y-3">
    <div class="flex items-center gap-2 text-xs uppercase font-bold tracking-wider text-slate-900 dark:text-white pb-2 border-b border-slate-200 dark:border-slate-800">
      <svg class="w-4 h-4 text-brand-600 dark:text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path>
      </svg>
      <span>On This Page</span>
    </div>
    <ul class="space-y-1.5 text-xs text-slate-600 dark:text-slate-400 max-h-[calc(100vh-14rem)] overflow-y-auto pr-2 list-none p-0 m-0">
      {tocHeadings.map((heading) => (
        <li class={`m-0 p-0 ${heading.depth === 3 ? 'pl-3 border-l border-slate-200 dark:border-slate-800' : ''}`}>
          <a
            href={`#${heading.slug}`}
            class="block py-1 hover:text-brand-600 dark:hover:text-brand-400 transition-colors line-clamp-1 leading-snug"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
