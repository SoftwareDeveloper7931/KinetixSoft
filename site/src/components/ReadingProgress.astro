---

<div id="reading-progress-container" class="fixed top-0 left-0 w-full h-1 z-50 pointer-events-none">
  <div id="reading-progress-bar" class="h-full bg-gradient-to-r from-brand-600 via-sky-400 to-indigo-500 w-0 transition-all duration-75"></div>
</div>

<script is:inline>
  window.addEventListener('scroll', () => {
    const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
    const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
    const bar = document.getElementById('reading-progress-bar');
    if (bar) {
      bar.style.width = scrolled + '%';
    }
  });
</script>
