---
export interface Props {
  takeaways: string[];
}

const { takeaways } = Astro.props;
---

{takeaways && takeaways.length > 0 && (
  <div class="my-8 rounded-2xl bg-gradient-to-br from-brand-50 to-sky-50 dark:from-brand-950/40 dark:to-slate-900 border border-brand-200/80 dark:border-brand-800/40 p-6 shadow-sm">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-8 h-8 rounded-lg bg-brand-600 text-white flex items-center justify-center font-bold text-sm shadow-sm shadow-brand-600/30">
        💡
      </div>
      <h3 class="text-base font-bold text-slate-900 dark:text-white m-0">Key Takeaways</h3>
    </div>
    <ul class="space-y-2.5 text-sm text-slate-700 dark:text-slate-300 m-0 p-0 list-none">
      {takeaways.map((point) => (
        <li class="flex items-start gap-2.5 m-0 p-0">
          <svg class="w-5 h-5 text-brand-600 dark:text-brand-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="leading-relaxed">{point}</span>
        </li>
      ))}
    </ul>
  </div>
)}
