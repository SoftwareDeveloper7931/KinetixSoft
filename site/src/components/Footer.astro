---
---

<footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-[#070a10] transition-colors mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10">
      <!-- Col 1 & 2: Brand & Mission -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand-600 to-sky-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <span class="font-bold text-lg text-slate-900 dark:text-white">KinetixSoft</span>
        </div>
        <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed max-w-sm">
          KinetixSoft is a premier FlutterFlow app development agency. We architect, design, and engineer scalable mobile and web applications with production-grade Firebase, Supabase, Stripe, and AI backends.
        </p>
        <div class="pt-2">
          <a href="/contact/" class="inline-flex items-center gap-2 text-xs font-semibold px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white shadow-sm shadow-brand-600/30 transition-all">
            <span>Hire Us for Your FlutterFlow App</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Col 3: Categories -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Top Clusters</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href="/category/getting-started/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Getting Started</a></li>
          <li><a href="/category/authentication/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Authentication</a></li>
          <li><a href="/category/firebase/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Firebase Backend</a></li>
          <li><a href="/category/supabase/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Supabase Database</a></li>
          <li><a href="/category/security/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Security Rules</a></li>
          <li><a href="/category/payments/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Stripe & RevenueCat</a></li>
        </ul>
      </div>

      <!-- Col 4: Platform & Code -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Advanced Guides</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href="/category/ai-integrations/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">AI & OpenAI Chatbots</a></li>
          <li><a href="/category/custom-code/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Custom Dart Actions</a></li>
          <li><a href="/category/email-marketing/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Brevo Integration</a></li>
          <li><a href="/category/performance/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Performance Optimization</a></li>
          <li><a href="/category/workflow-teams/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Git Branching & Teams</a></li>
          <li><a href="/rss.xml" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">RSS Feed (XML)</a></li>
        </ul>
      </div>

      <!-- Col 5: Company & Legal -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-900 dark:text-white">Company</h4>
        <ul class="space-y-2 text-xs text-slate-600 dark:text-slate-400">
          <li><a href="/about/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">About KinetixSoft</a></li>
          <li><a href="/contact/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Contact & Inquiries</a></li>
          <li><a href="/privacy/" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Privacy Policy</a></li>
          <li><a href="https://kinetixsoft.com" class="hover:text-brand-600 dark:hover:text-brand-400 transition-colors">Main Website</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 pt-8 border-t border-slate-200 dark:border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 dark:text-slate-500 gap-4">
      <p>© 2026 KinetixSoft. All rights reserved. Built with Astro &amp; Tailwind CSS for ultra-fast performance.</p>
      <div class="flex items-center gap-5">
        <a href="https://twitter.com/kinetixsoft" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 dark:hover:text-slate-300">Twitter</a>
        <a href="https://linkedin.com/company/kinetixsoft" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 dark:hover:text-slate-300">LinkedIn</a>
        <a href="https://github.com/kinetixsoft" target="_blank" rel="noopener noreferrer" class="hover:text-slate-700 dark:hover:text-slate-300">GitHub</a>
      </div>
    </div>
  </div>
</footer>
