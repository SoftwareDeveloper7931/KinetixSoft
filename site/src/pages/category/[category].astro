---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, type CategoryMeta } from '../../data/categories';
import CallToAction from '../../components/CallToAction.astro';

export async function getStaticPaths() {
  return Object.values(categories).map((cat) => ({
    params: { category: cat.slug },
    props: { catMeta: cat },
  }));
}

export interface Props {
  catMeta: CategoryMeta;
}

const { catMeta } = Astro.props;

const allTutorials = await getCollection('tutorials');
const categoryTutorials = allTutorials.filter(
  (t) => t.data.category.toLowerCase().replace(/ & /g, '-').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') === catMeta.slug
);

const breadcrumbs = [
  { name: 'Home', url: 'https://kinetixsoft.com/' },
  { name: 'Tutorials', url: 'https://kinetixsoft.com/tutorials/' },
  { name: catMeta.name, url: `https://kinetixsoft.com/category/${catMeta.slug}/` }
];
---

<BaseLayout
  title={`${catMeta.name} in FlutterFlow: Tutorials & Architecture (2026) | KinetixSoft`}
  description={`Master FlutterFlow ${catMeta.name}. Deep-dive technical guides, code snippets, and production architecture patterns by KinetixSoft engineers.`}
  canonicalUrl={`https://kinetixsoft.com/category/${catMeta.slug}/`}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
        <li><a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a></li>
        <li><span>/</span></li>
        <li><a href="/tutorials/" class="hover:text-brand-600 dark:hover:text-brand-400">Tutorials</a></li>
        <li><span>/</span></li>
        <li class="font-medium text-slate-900 dark:text-slate-200">{catMeta.name}</li>
      </ol>
    </nav>

    <!-- Category Header -->
    <header class="max-w-4xl mb-12 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-brand-50 text-brand-700 dark:bg-brand-950/60 dark:text-brand-300 border border-brand-200 dark:border-brand-800/60">
        <span>{catMeta.icon}</span>
        <span>Topic Hub</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        FlutterFlow {catMeta.name} Tutorials
      </h1>

      <!-- 150-250 Word Unique Intro Copy with Pillar Link -->
      <div class="prose prose-slate dark:prose-invert max-w-none text-base sm:text-lg leading-relaxed text-slate-600 dark:text-slate-300 pt-2">
        {catMeta.intro.split('\n\n').map((paragraph) => (
          <p set:html={paragraph.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-brand-600 dark:text-brand-400 underline font-semibold hover:text-brand-700">$1</a>')} />
        ))}
      </div>
    </header>

    <!-- Tutorial List Header -->
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200 dark:border-slate-800">
      <h2 class="text-xl font-bold text-slate-900 dark:text-white">
        Available Guides in this Hub ({categoryTutorials.length})
      </h2>
      <a href="/tutorials/" class="text-xs font-semibold text-brand-600 dark:text-brand-400 hover:underline">
        Browse all 31 tutorials →
      </a>
    </div>

    <!-- Tutorials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categoryTutorials.map((t) => (
        <article class="group rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 p-6 shadow-sm hover:shadow-md hover:border-brand-500/50 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
                {t.data.difficulty}
              </span>
              <span class="text-[11px] text-slate-400">{t.data.readingTime}</span>
            </div>

            <h3 class="text-base font-bold text-slate-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400 transition-colors line-clamp-2 mb-2">
              <a href={`/${t.slug}/`}>
                {t.data.title.split(' (2026')[0].split(' | ')[0]}
              </a>
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-3 leading-relaxed mb-4">
              {t.data.description}
            </p>
          </div>

          <div class="pt-3 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500">
            <span>By {t.data.author}</span>
            <a href={`/${t.slug}/`} class="font-semibold text-brand-600 dark:text-brand-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
              Read Guide <span>→</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Hub Call to Action -->
    <div class="mt-16">
      <CallToAction
        headline={`Building a FlutterFlow app requiring ${catMeta.name}?`}
        subtext={`Partner with KinetixSoft's senior engineers to design and deploy battle-tested ${catMeta.name} solutions tailored to your product specifications.`}
      />
    </div>
  </div>
</BaseLayout>
