---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) | KinetixSoft"
  description="The tutorial or page you requested could not be found. Explore our FlutterFlow tutorials directory."
  canonicalUrl="https://kinetixsoft.com/404/"
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-brand-50 dark:bg-brand-950/60 text-brand-600 dark:text-brand-400 font-extrabold text-3xl border border-brand-200 dark:border-brand-800">
      404
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Page Not Found
    </h1>
    <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
      The tutorial or resource you were looking for may have moved or been updated. You can search our entire library of 31+ FlutterFlow engineering tutorials.
    </p>

    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/tutorials/"
        class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs transition-transform hover:scale-105 active:scale-95 shadow-sm shadow-brand-600/30"
      >
        Browse All Tutorials
      </a>
      <a
        href="/"
        class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 font-semibold text-xs transition-colors"
      >
        Return to Homepage
      </a>
    </div>
  </div>
</BaseLayout>
